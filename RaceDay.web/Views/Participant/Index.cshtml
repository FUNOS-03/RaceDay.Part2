@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>Welcome, @ViewBag.FullName!</h1>
        <p class="text-muted">
            Welcome to your RaceDay Participant Dashboard.
            Discover events, manage your enrolments and track your results.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card p-4 h-100">
                <h4>Upcoming Events</h4>
                <p>Explore upcoming running, walking and cycling events.</p>
                <a asp-controller="ParticipantEvents"
                   asp-action="Index"
                   class="btn btn-primary">
                    Explore Events
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 h-100">
                <h4>My Enrolments</h4>
                <p>View the events you have registered to participate in.</p>
                <a asp-controller="ParticipantEvents"
                   asp-action="MyEnrolments"
                   class="btn btn-primary">
                    My Enrolments
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 h-100">
                <h4>My Results</h4>
                <p>Track your race performances and finishing positions.</p>
                <a asp-controller="ParticipantResults"
                   asp-action="Index"
                   class="btn btn-primary">
                    View Results
                </a>
            </div>
        </div>

    </div>

</div>
