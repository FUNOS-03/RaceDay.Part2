@model RaceDay.web.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">My Profile</h1>
        <p class="text-muted">
            Manage your RaceDay account information and profile picture.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-controller="Profile"
                  asp-action="Update"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="text-center mb-4">

                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl"
                             alt="Profile picture"
                             class="rounded-circle mb-3"
                             style="width:130px;height:130px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3"
                             style="width:130px;height:130px;">
                            <span class="fw-bold text-muted fs-1">
                                @(string.IsNullOrWhiteSpace(Model.FullName)
                                                            ? "?"
                                                            : Model.FullName.Substring(0, 1).ToUpper())
                        </span>
                    </div>
                                        }

                    <h5>Profile Picture</h5>

                    <input asp-for="ProfilePicture"
                           type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <span asp-validation-for="ProfilePicture"
                          class="text-danger"></span>

                    <small class="text-muted">
                        JPG, PNG or WEBP. Maximum size: 5 MB.
                    </small>

                </div>

                <hr />

                <div class="mb-3">
                    <label asp-for="FullName"
                           class="form-label fw-semibold">
                        Full Name
                    </label>

                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Enter your full name" />

                    <span asp-validation-for="FullName"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email"
                           class="form-label fw-semibold">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter your email address" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
