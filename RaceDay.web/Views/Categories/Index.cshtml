@model List<RaceDay.web.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Manage Categories</h1>
            <p class="text-muted">Create and manage RaceDay event categories.</p>
        </div>
        <a asp-controller="Organiser" asp-action="Index"
           class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">Create New Category</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No event categories are available yet.</div>
    }
    else
    {
        <div class="card p-3">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>@category.Name</td>
                                <td>@category.Description</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@category.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>

                                    <form asp-action="Delete" asp-route-id="@category.Id"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this category?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
