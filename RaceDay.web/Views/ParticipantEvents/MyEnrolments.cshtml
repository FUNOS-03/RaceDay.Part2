@model List<RaceDay.web.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container py-4">

    <h1>My Enrolments</h1>
    <p class="text-muted">View and manage your registered sporting events.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card p-4 text-center">
            <h4>You have no enrolments yet.</h4>
            <p>Browse upcoming events to get started.</p>
            <a asp-controller="ParticipantEvents"
               asp-action="Index"
               class="btn btn-primary">
                Browse Events
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Location</th>
                        <th>Event Date</th>
                        <th>Category</th>
                        <th>Enrolled On</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>@enrolment.EventName</td>
                            <td>@enrolment.Location</td>
                            <td>@enrolment.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@enrolment.Category</td>
                            <td>@enrolment.EnrolledAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge status-confirmed">
                                    @enrolment.Status
                                </span>
                            </td>
                            <td>
                                <form asp-controller="ParticipantEvents"
                                      asp-action="Cancel"
                                      method="post"
                                      onsubmit="return confirm('Cancel this enrolment?');">

                                    <input type="hidden"
                                           name="id"
                                           value="@enrolment.Id" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Cancel
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="ParticipantEvents"
       asp-action="Index"
       class="btn btn-outline-primary mt-3">
        Browse Events
    </a>

</div>
