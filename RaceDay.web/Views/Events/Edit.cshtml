
@model RaceDay.web.Models.EventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card p-4 shadow-sm">
                <div class="card-body">

                    <h1>Edit RaceDay Event</h1>
                    <p class="text-muted">
                        Update the event details and upload a new banner if required.
                    </p>

                    <form asp-controller="Events"
                          asp-action="Edit"
                          method="post"
                          enctype="multipart/form-data">

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name"
                                   class="form-label fw-bold">
                                Event Name
                            </label>
                            <input asp-for="Name"
                                   class="form-control" />
                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label fw-bold">
                                Description
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location"
                                   class="form-label fw-bold">
                                Location
                            </label>
                            <input asp-for="Location"
                                   class="form-control" />
                            <span asp-validation-for="Location"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDate"
                                   class="form-label fw-bold">
                                Event Date
                            </label>
                            <input asp-for="EventDate"
                                   type="date"
                                   class="form-control" />
                            <span asp-validation-for="EventDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaximumParticipants"
                                   class="form-label fw-bold">
                                Maximum Participants
                            </label>
                            <input asp-for="MaximumParticipants"
                                   type="number"
                                   class="form-control" />
                            <span asp-validation-for="MaximumParticipants"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventCategoryId"
                                   class="form-label fw-bold">
                                Event Category
                            </label>

                            <select asp-for="EventCategoryId"
                                    class="form-select"
                                    asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Categories, "Id", "Name"))">
                                <option value="">Select a category</option>
                            </select>

                            <span asp-validation-for="EventCategoryId"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BannerImage"
                                   class="form-label fw-bold">
                                Replace Event Banner
                            </label>

                            <input asp-for="BannerImage"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp" />

                            <div class="form-text">
                                Optional. Leave empty to keep the existing banner.
                                Accepted formats: JPG, PNG and WEBP. Maximum 5 MB.
                            </div>

                            <span asp-validation-for="BannerImage"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg">
                            Save Changes
                        </button>

                        <a asp-controller="Events"
                           asp-action="Index"
                           class="btn btn-outline-secondary btn-lg ms-2">
                            Cancel
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
