@{
    ViewData["Title"] = "Home";
}

<section class="p-5 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #10243a, #244d70);">

    <div class="row align-items-center">
        <div class="col-lg-7">
            <p class="text-uppercase fw-bold"
               style="color:#f47721; letter-spacing:2px;">
                Welcome to RaceDay
            </p>

            <h1 class="display-4 fw-bold text-white">
                Every Race.<br />Every Challenge.<br />Your Moment.
            </h1>

            <p class="lead mt-3">
                Discover exciting running, walking and cycling events.
                Register, compete and celebrate every achievement.
            </p>

            <a href="#upcoming-events"
               class="btn btn-primary btn-lg mt-3">
                Explore Events
            </a>
        </div>

        <div class="col-lg-5 text-center mt-4 mt-lg-0">
            <div style="font-size:120px;">🏃</div>
            <h4 class="text-white">RUN • WALK • CYCLE</h4>
        </div>
    </div>
</section>

<section id="upcoming-events" class="py-4">
    <div class="text-center mb-4">
        <h2>Discover RaceDay</h2>
        <p class="text-muted">
            Your next sporting adventure starts here.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 p-3">
                <div class="card-body text-center">
                    <div style="font-size:50px;">🏃</div>
                    <h4>Running Events</h4>
                    <p>
                        Challenge yourself with exciting running
                        events and different race distances.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-3">
                <div class="card-body text-center">
                    <div style="font-size:50px;">🚶</div>
                    <h4>Walking Events</h4>
                    <p>
                        Stay active and enjoy walking events
                        suitable for different fitness levels.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-3">
                <div class="card-body text-center">
                    <div style="font-size:50px;">🚴</div>
                    <h4>Cycling Events</h4>
                    <p>
                        Take on new routes and cycling challenges
                        with the RaceDay community.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>

<section class="text-center py-5">
    <h2>Ready to make your mark?</h2>
    <p class="text-muted">
        Join RaceDay and become part of the experience.
    </p>
    <a href="#" class="btn btn-primary btn-lg">
        Get Started
    </a>
</section>
