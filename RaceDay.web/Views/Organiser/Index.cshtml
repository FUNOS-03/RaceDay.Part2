@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>Welcome, @ViewBag.FullName!</h1>
        <p class="text-muted">
            Welcome to your RaceDay Organiser Dashboard.
            Manage events, categories, participants and race results.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card p-4 h-100">
                <h4>Manage Events</h4>
                <p>Create, update and manage RaceDay events.</p>
                <a asp-controller="Events" asp-action="Index"
                   class="btn btn-primary">Manage Events</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 h-100">
                <h4>Manage Categories</h4>
                <p>Create and manage event categories.</p>
                <a asp-controller="Categories" asp-action="Index"
                   class="btn btn-primary">Manage Categories</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 h-100">
                <h4>Participant Enrolments</h4>
                <p>View participants enrolled in RaceDay events.</p>
                <a asp-controller="OrganiserEnrolments" asp-action="Index"
                   class="btn btn-primary">View Enrolments</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 h-100">
                <h4>Race Results</h4>
                <p>Record and review participant race results.</p>
                <a asp-controller="OrganiserResults" asp-action="Index"
                   class="btn btn-primary">Manage Results</a>
            </div>
        </div>

    </div>
</div>