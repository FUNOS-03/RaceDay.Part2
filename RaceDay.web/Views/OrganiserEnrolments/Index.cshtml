@model List<RaceDay.web.Models.OrganiserEnrolmentViewModel>

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="container py-4">

    <h1>Participant Enrolments</h1>
    <p class="text-muted">
        View participants registered for RaceDay events.
    </p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card p-4 text-center">
            <h4>No enrolments found</h4>
            <p>Participant registrations will appear here.</p>
        </div>
    }
    else
    {
        <div class="card p-3">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Email</th>
                            <th>Event</th>
                            <th>Location</th>
                            <th>Event Date</th>
                            <th>Category</th>
                            <th>Enrolled On</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var enrolment in Model)
                        {
                            <tr>
                                <td>@enrolment.ParticipantName</td>
                                <td>@enrolment.ParticipantEmail</td>
                                <td>@enrolment.EventName</td>
                                <td>@enrolment.EventLocation</td>
                                <td>@enrolment.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@enrolment.Category</td>
                                <td>@enrolment.EnrolledAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-success">
                                        @enrolment.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-outline-primary">
            Back to Dashboard
        </a>
    </div>

</div>
